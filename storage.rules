rules_version = '2';

// Finance attachments (bills / receipts). Only finance roles can read or
// upload; the role is looked up from the user's Firestore profile.
// NOTE: this file did not exist in the repo before the Finance module. If a
// storage.rules is already deployed for this Firebase project, MERGE the
// finance block below into it instead of replacing it.
service firebase.storage {
  match /b/{bucket}/o {
    function financeRole() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin', 'accountant'];
    }

    match /finance/{allPaths=**} {
      allow read: if financeRole();
      allow write: if financeRole() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
