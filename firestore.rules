rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }

    function isAdmin() {
      return myRole() in ['super_admin', 'admin'];
    }

    function isHR() {
      return myRole() in ['super_admin', 'admin', 'hr'];
    }

    // Attendance is the one HR-adjacent area where 'admin' is deliberately
    // NOT treated as a manager: admin marks their own attendance like any
    // other employee, and only super_admin/HR can view or edit everyone
    // else's records. Scoped narrowly to the /attendance collection below —
    // isHR() keeps including 'admin' everywhere else (leave, comp-off,
    // dailyReports, devices, users), which is unchanged.
    function isAttendanceManager() {
      return myRole() in ['super_admin', 'hr'];
    }

    // NEW: Finance module (ledger, payroll, loans). super_admin/admin/accountant.
    function isFinance() {
      return myRole() in ['super_admin', 'admin', 'accountant'];
    }

    function isProjectOps() {
      return myRole() in ['super_admin', 'admin', 'project_manager'];
    }

    function isLeaderOfProject(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.leaderUid == request.auth.uid;
    }

    function isCalendarViewer() {
      return isProjectOps() || isHR();
    }

    function isDeliverableAssigneeOfProject(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data
          .get('assignedDeliverableUids', []).hasAny([request.auth.uid]);
    }

    function isClientQuoteResponse() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'clientResponseNote', 'respondedAt']) &&
        request.resource.data.status in ['accepted', 'declined'];
    }

    function isSelfUpdatingOwnAssignment(projectId, eventId) {
      return isSignedIn() &&
        resource.data.get('assignedUids', []).hasAny([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team', 'updatedAt']);
    }

    // Any signed-in employee may thumbs-up the dashboard note, but ONLY by
    // adding or removing their own key inside the `acks` map. The note text,
    // author and timestamp stay project-ops-only, and nobody can acknowledge
    // on someone else's behalf. get('acks', {}) covers notes posted before
    // the field existed, which have no acks map at all.
    function isOwnAnnouncementAck() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acks']) &&
        request.resource.data.get('acks', {}).diff(resource.data.get('acks', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    // --- users (employee profiles) ---
    // role is the sensitive field. Only admin/super_admin may change it, nobody
    // changes their own, and only a super_admin may grant or remove super_admin.
    function roleChangeAllowed(uid) {
      return request.resource.data.get('role', null) == resource.data.get('role', null) ||
        (isAdmin() && request.auth.uid != uid &&
          (myRole() == 'super_admin' ||
            (request.resource.data.get('role', null) != 'super_admin' && resource.data.get('role', null) != 'super_admin')));
    }

    // A super_admin's profile can only be edited by a super_admin — except the
    // leave-balance bookkeeping that leave / comp-off approval writes.
    function superAdminProfileGuard() {
      return resource.data.get('role', null) != 'super_admin' || myRole() == 'super_admin' ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaveBalance', 'updatedAt']);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // HR / admin manage profiles (edit, deactivate, leave balance) within the role guards above.
      allow update: if isHR() && roleChangeAllowed(uid) && superAdminProfileGuard();
      // Self-service is limited to what the app writes on login / password change.
      // (Previously any employee could rewrite their own doc — including role.)
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'forcePasswordChange', 'updatedAt']);
      allow create, delete: if false;
    }

    // --- attendance --- (doc id pattern: {employeeUid}_{date})
    // 'admin' is intentionally NOT an attendance manager here — admin can
    // only get/list/update their own record, same as any employee.
    // Finance roles get read-only access so payroll can count leave/LOP.
    match /attendance/{docId} {
      allow get: if isAttendanceManager() || isFinance() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);   // CHANGED: + isFinance()
      allow list: if isAttendanceManager() || isFinance() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);   // CHANGED: + isFinance()
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid && docId.split('_')[0] == request.auth.uid;
      // Self-service updates are check-out and breaks only — an employee can't
      // rewrite their own check-in time or status.
      allow update: if isAttendanceManager() ||
        (isSignedIn() && docId.split('_')[0] == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutTime', 'totalWorkingMs', 'breaks']));
      allow delete: if isAdmin();
    }

    // --- leaveRequests --- (random auto-ids)
    match /leaveRequests/{docId} {
      allow read: if isHR() || isFinance() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);   // CHANGED: + isFinance()
      // New requests always start pending — nobody files an already-approved leave.
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      // An employee may only withdraw their own *pending* request; approving or
      // rejecting stays with HR (previously they could approve their own).
      allow update: if isHR() ||
        (isSignedIn() && resource.data.employeeUid == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['pending', 'cancelled'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'updatedAt', 'cancelledAt']));
      allow delete: if isAdmin();
    }

    // --- devices --- (doc id pattern: {employeeUid}_{fingerprint})
    match /devices/{docId} {
      allow get: if isHR() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);
      allow list: if isHR();
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid && docId.split('_')[0] == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- dailyReports --- (doc id pattern: {employeeUid}_{date})
    match /dailyReports/{docId} {
      allow get: if isHR() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);
      allow list: if isHR() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid && docId.split('_')[0] == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- compOffRequests ---
    match /compOffRequests/{docId} {
      allow read: if isHR() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isHR();
      allow delete: if isAdmin();
    }

    // --- freelancers ---
    match /freelancers/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }

    // --- leads (admin/PM only) ---
    match /leads/{leadId} {
      allow read, write: if isProjectOps();
      match /activities/{activityId} {
        allow read, create: if isProjectOps();
        allow update, delete: if isAdmin();
      }
    }

    match /enquiryResponses/{responseId} {
      allow read: if isProjectOps();
      allow create, update, delete: if false;
    }

    match /quotations/{quotationId} {
      allow get: if true;
      allow list: if isProjectOps();
      allow create: if isProjectOps();
      allow update: if isProjectOps() || isClientQuoteResponse();
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update: if isProjectOps();
      allow delete: if false;
    }

    match /packageTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }
    match /contractTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }
    match /paymentScheduleTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }
    match /orgSettings/{docId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isProjectOps() || isFinance();   // CHANGED: + isFinance() (finance categories)
    }

    match /invoices/{invoiceId} {
      allow read: if isProjectOps() || isFinance();   // CHANGED: + isFinance()
      allow create, update, delete: if isProjectOps();
    }

    match /expenses/{expenseId} {
      allow read: if isProjectOps() || isFinance();   // CHANGED: + isFinance()
      allow create, update, delete: if isProjectOps();
    }

    // ===== NEW: Finance module (admin / super_admin / accountant only) =====
    match /financeAccounts/{docId} {
      allow read, write: if isFinance();
    }

    match /financeTransactions/{docId} {
      allow read, write: if isFinance();
    }

    match /allowances/{docId} {
      allow read, write: if isFinance();
    }

    match /loans/{docId} {
      allow read, write: if isFinance();
    }

    // Salary structure / increments / staff advances — never employee-writable.
    match /employeeFinance/{docId} {
      allow read, write: if isFinance();
    }

    match /employeeAdvances/{docId} {
      allow read, write: if isFinance();
    }

    // Salary runs + payslips: finance manages them; an employee may read only
    // their own (payslip download).
    match /payrolls/{docId} {
      allow read: if isFinance() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow write: if isFinance();
    }
    // ===== end Finance module =====

    match /postProdTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isProjectOps();
      allow update: if isProjectOps() ||
        (isSignedIn() && resource.data.assignedUid == request.auth.uid) ||
        (isSignedIn() && ('assignedUids' in resource.data) && resource.data.assignedUids.hasAny([request.auth.uid]));
    }

    // Storage logging is a handoff record, not a permission gate: anyone
    // signed in can log a storage entry for anyone on any project (a
    // photographer might hand cards to whoever's around to log them, not
    // only whoever the deliverable happens to be assigned to). What's
    // enforced is honest attribution — loggedByUid must be the caller's
    // own uid, so you can never log an entry that claims to be someone
    // else's submission. Editing or deleting an entry is limited to
    // whoever actually logged it, or an admin/PM — not to the member the
    // storage is about, since that person may not be the one who typed it
    // in and shouldn't be able to alter someone else's submission.
    match /storageEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isProjectOps() ||
        (isSignedIn() && request.resource.data.loggedByUid == request.auth.uid);
      allow update, delete: if isProjectOps() ||
        (isSignedIn() && resource.data.loggedByUid == request.auth.uid);
    }

    match /rateCards/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }

    // --- calendarBookings ---
    // The "Meetings & Tasks" layer on the Team Calendar — internal
    // scheduling, deliberately separate from project shoot events.
    // Anyone signed in can book a slot for anyone else (that's the
    // point — a PM should be able to put a meeting on someone's
    // calendar without needing that person to do it themselves).
    // Ownership still governs edits: only the creator or an admin/PM
    // can change or remove a booking once made.
    match /calendarBookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isProjectOps() ||
        (isSignedIn() && resource.data.createdByUid == request.auth.uid);
    }

    match /notifications/{docId} {
      allow read, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Clearing notifications is self-service — a user deletes their own
      // (individually or all at once); admins can still remove anyone's.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // --- announcements ---
    // Split from a blanket `write` so employees can acknowledge the
    // dashboard note (see isOwnAnnouncementAck) while posting, editing and
    // removing it stay project-ops-only.
    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isProjectOps();
      allow update: if isProjectOps() || isOwnAnnouncementAck();
    }

    match /projects/{projectId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isProjectOps();
      // A Project Leader runs their project day to day, but can't reassign the
      // leader role or change the money/link fields — those stay admin/PM.
      allow update: if isProjectOps() ||
        (isSignedIn() && resource.data.leaderUid == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['leaderUid', 'leaderName', 'quotationAmount', 'quotationId', 'leadId']));
      allow delete: if isAdmin();

      match /deliverables/{deliverableId} {
        allow read: if isSignedIn();
        allow create, delete: if isProjectOps();
        allow update: if isProjectOps() ||
          (isSignedIn() && resource.data.assignedUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updates', 'updatedAt']));
      }

      match /events/{eventId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isProjectOps() || isLeaderOfProject(projectId);
        allow update: if isProjectOps() || isLeaderOfProject(projectId) ||
          isSelfUpdatingOwnAssignment(projectId, eventId);
        allow delete: if isAdmin();

        match /statusUpdates/{uid} {
          allow get, list: if isProjectOps() || isLeaderOfProject(projectId) ||
            (isSignedIn() && uid == request.auth.uid);
          allow create, update: if isSignedIn() && uid == request.auth.uid;
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/events/{eventId} {
      allow list: if isSignedIn();
    }

    match /{path=**}/deliverables/{deliverableId} {
      allow list: if isProjectOps() ||
        (isSignedIn() && resource.data.assignedUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
