rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : null;
    }

    function isAdmin() {
      return myRole() in ['super_admin', 'admin'];
    }

    function isHR() {
      return myRole() in ['super_admin', 'admin', 'hr'];
    }

    // Attendance is the one HR-adjacent area where 'admin' is deliberately
    // NOT treated as a manager: admin marks their own attendance like any
    // other employee, and only super_admin/HR can view or edit everyone
    // else's records. Scoped narrowly to the /attendance collection below —
    // isHR() keeps including 'admin' everywhere else (leave, comp-off,
    // dailyReports, devices, users), which is unchanged.
    function isAttendanceManager() {
      return myRole() in ['super_admin', 'hr'];
    }

    function isProjectOps() {
      return myRole() in ['super_admin', 'admin', 'project_manager'];
    }

    function isLeaderOfProject(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.leaderUid == request.auth.uid;
    }

    function isCalendarViewer() {
      return isProjectOps() || isHR();
    }

    function isDeliverableAssigneeOfProject(projectId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data
          .get('assignedDeliverableUids', []).hasAny([request.auth.uid]);
    }

    function isClientQuoteResponse() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'clientResponseNote', 'respondedAt']) &&
        request.resource.data.status in ['accepted', 'declined'];
    }

    function isSelfUpdatingOwnAssignment(projectId, eventId) {
      return isSignedIn() &&
        resource.data.get('assignedUids', []).hasAny([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team', 'updatedAt']);
    }

    // Any signed-in employee may thumbs-up the dashboard note, but ONLY by
    // adding or removing their own key inside the `acks` map. The note text,
    // author and timestamp stay project-ops-only, and nobody can acknowledge
    // on someone else's behalf. get('acks', {}) covers notes posted before
    // the field existed, which have no acks map at all.
    function isOwnAnnouncementAck() {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acks']) &&
        request.resource.data.get('acks', {}).diff(resource.data.get('acks', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    // --- users (employee profiles) ---
    match /users/{uid} {
      allow read: if isSignedIn();
      allow update: if isHR() || (isSignedIn() && request.auth.uid == uid);
      allow create, delete: if false;
    }

    // --- attendance --- (doc id pattern: {employeeUid}_{date})
    // 'admin' is intentionally NOT an attendance manager here — admin can
    // only get/list/update their own record, same as any employee.
    match /attendance/{docId} {
      allow get: if isAttendanceManager() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);
      allow list: if isAttendanceManager() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid && docId.split('_')[0] == request.auth.uid;
      allow update: if isAttendanceManager() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- leaveRequests --- (random auto-ids)
    match /leaveRequests/{docId} {
      allow read: if isHR() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid;
      allow update: if isHR() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- devices --- (doc id pattern: {employeeUid}_{fingerprint})
    match /devices/{docId} {
      allow get: if isHR() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);
      allow list: if isHR();
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid && docId.split('_')[0] == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- dailyReports --- (doc id pattern: {employeeUid}_{date})
    match /dailyReports/{docId} {
      allow get: if isHR() || (isSignedIn() && docId.split('_')[0] == request.auth.uid);
      allow list: if isHR() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid && docId.split('_')[0] == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- compOffRequests ---
    match /compOffRequests/{docId} {
      allow read: if isHR() || (isSignedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid;
      allow update: if isHR();
      allow delete: if isAdmin();
    }

    // --- freelancers ---
    match /freelancers/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }

    // --- leads (admin/PM only) ---
    match /leads/{leadId} {
      allow read, write: if isProjectOps();
      match /activities/{activityId} {
        allow read, create: if isProjectOps();
        allow update, delete: if isAdmin();
      }
    }

    match /enquiryResponses/{responseId} {
      allow read: if isProjectOps();
      allow create, update, delete: if false;
    }

    match /quotations/{quotationId} {
      allow get: if true;
      allow list: if isProjectOps();
      allow create: if isProjectOps();
      allow update: if isProjectOps() || isClientQuoteResponse();
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update: if isProjectOps();
      allow delete: if false;
    }

    match /packageTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }
    match /contractTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }
    match /paymentScheduleTemplates/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }
    match /orgSettings/{docId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isProjectOps();
    }

    match /invoices/{invoiceId} {
      allow read: if isProjectOps();
      allow create, update, delete: if isProjectOps();
    }

    match /expenses/{expenseId} {
      allow read: if isProjectOps();
      allow create, update, delete: if isProjectOps();
    }

    match /postProdTasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isProjectOps();
      allow update: if isProjectOps() ||
        (isSignedIn() && resource.data.assignedUid == request.auth.uid) ||
        (isSignedIn() && ('assignedUids' in resource.data) && resource.data.assignedUids.hasAny([request.auth.uid]));
    }

    match /storageEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isProjectOps() ||
        (isSignedIn() && request.resource.data.loggedByUid == request.auth.uid &&
          isDeliverableAssigneeOfProject(request.resource.data.projectId));
      allow update, delete: if isProjectOps() ||
        (isSignedIn() && resource.data.loggedByUid == request.auth.uid);
    }

    match /rateCards/{docId} {
      allow read: if isSignedIn();
      allow write: if isProjectOps();
    }

    match /notifications/{docId} {
      allow read, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- announcements ---
    // Split from a blanket `write` so employees can acknowledge the
    // dashboard note (see isOwnAnnouncementAck) while posting, editing and
    // removing it stay project-ops-only.
    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isProjectOps();
      allow update: if isProjectOps() || isOwnAnnouncementAck();
    }

    match /projects/{projectId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isProjectOps();
      allow update: if isProjectOps() || (isSignedIn() && resource.data.leaderUid == request.auth.uid);
      allow delete: if isAdmin();

      match /deliverables/{deliverableId} {
        allow read: if isSignedIn();
        allow create, delete: if isProjectOps();
        allow update: if isProjectOps() ||
          (isSignedIn() && resource.data.assignedUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updates', 'updatedAt']));
      }

      match /events/{eventId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isProjectOps() || isLeaderOfProject(projectId);
        allow update: if isProjectOps() || isLeaderOfProject(projectId) ||
          isSelfUpdatingOwnAssignment(projectId, eventId);
        allow delete: if isAdmin();

        match /statusUpdates/{uid} {
          allow get, list: if isProjectOps() || isLeaderOfProject(projectId) ||
            (isSignedIn() && uid == request.auth.uid);
          allow create, update: if isSignedIn() && uid == request.auth.uid;
          allow delete: if isAdmin();
        }
      }
    }

    match /{path=**}/events/{eventId} {
      allow list: if isSignedIn();
    }

    match /{path=**}/deliverables/{deliverableId} {
      allow list: if isProjectOps() ||
        (isSignedIn() && resource.data.assignedUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}